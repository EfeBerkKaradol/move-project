# API tabanı — local geliştirmede Spring Boot
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Kimlik: Auth.js + Keycloak ────────────────────────────────────
# Web uygulaması sunucu tarafında oturum tutar (Auth.js), Keycloak'a gizli istemci
# olarak bağlanır. Değerler yerel Keycloak'ın realm dosyasıyla eşleşir.
AUTH_KEYCLOAK_ID=tasiyoruz-web
AUTH_KEYCLOAK_SECRET=tasiyoruz-web-dev-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8081/realms/tasiyoruz
# Oturum çerezlerinin imza anahtarı. Üretmek için: openssl rand -base64 32
AUTH_SECRET=
# Yerelde localhost'a güven; üretimde AUTH_URL tanımlanır, bu satır kalkar
AUTH_TRUST_HOST=true

# Google Maps: istemci anahtarı YOK. Tüm harita çağrıları backend üzerinden geçer
# (docs/03 — maliyet kontrolü ve anahtar güvenliği).
