# ─────────────────────────────────────────────────────────────────────
# Taşıyoruz web — yerel ortam değişkenleri
# Bu dosya git'e girmez. Vercel'de aynı anahtarları Project → Settings →
# Environment Variables altına gir (dosya yükleyemezsin).
# ─────────────────────────────────────────────────────────────────────

# API adresi (mutlak, sonda eğik çizgi yok). Boşsa http://localhost:8080.
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── #16 Kimlik: Auth.js + Keycloak ────────────────────────────────────
# Yereldeki değerler realm dosyasıyla eşleşir; üretimde Keycloak'ın gerçek adresi ve
# Clients → tasiyoruz-web → Credentials'taki sır girilir.
AUTH_KEYCLOAK_ID=tasiyoruz-web
AUTH_KEYCLOAK_SECRET=tasiyoruz-web-dev-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8081/realms/tasiyoruz

# Oturum çerezlerinin imza anahtarı. Üret: openssl rand -base64 32
AUTH_SECRET=

# Yerelde localhost'a güven. Üretimde bunun yerine AUTH_URL tanımlanır:
AUTH_TRUST_HOST=true
# AUTH_URL=https://tasiyoruz.com
