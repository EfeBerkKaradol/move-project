# Sürücü uygulaması — ortam değişkenleri
# Bu dosya git'e GİRER; buraya asla gerçek gizli değer yazma.
# Yerelde .env.local oluştur (gitignore'da), üretimde EAS secrets kullanılır.
#
# Hepsi herkese açık bilgi: mobil uygulama public client, gizli anahtarı yok.

# Simülatör localhost'u kendi makinen olarak görüyor; gerçek cihazda
# bilgisayarının yerel ağ adresini yaz (örn. http://192.168.1.36:8081/...).
EXPO_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8081/realms/tasiyoruz
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=tasiyoruz-driver-app
EXPO_PUBLIC_API_URL=http://localhost:8080
