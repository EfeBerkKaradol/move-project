{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "apps/web",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "api"
      ],
      "port": 8080
    },
    {
      "name": "karinca-driver",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "apps/driver",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8090"
      ],
      "port": 8090
    }
  ]
}
