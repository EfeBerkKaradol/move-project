{
  "realm": "tasiyoruz",
  "sslRequired": "NONE",
  "enabled": true,
  "displayName": "KARINCA",
  "defaultLocale": "tr",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "tr",
    "en"
  ],
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 2592000,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Yük sahibi"
      },
      {
        "name": "DRIVER",
        "description": "Nakliyeci / sürücü"
      },
      {
        "name": "FLEET_MANAGER",
        "description": "Filo yöneticisi"
      },
      {
        "name": "OPS_AGENT",
        "description": "Operasyon ajanı"
      },
      {
        "name": "COMPLIANCE",
        "description": "Hukuk ve uyum ekibi: uyum olayları, bildirimler, hesap kısıtlamaları"
      },
      {
        "name": "ADMIN",
        "description": "Sistem yöneticisi"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "default-roles-tasiyoruz",
        "description": "Yeni kaydolan kullanıcıların varsayılan rolleri",
        "composite": true,
        "composites": {
          "realm": [
            "CUSTOMER",
            "offline_access",
            "uma_authorization"
          ]
        },
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "tasiyoruz-web",
      "name": "Taşıyoruz Web",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "secret": "tasiyoruz-web-dev-secret",
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/"
    },
    {
      "clientId": "tasiyoruz-admin-web",
      "name": "Taşıyoruz Admin",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3001/*"
      ],
      "webOrigins": [
        "http://localhost:3001"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "rootUrl": "http://localhost:3001",
      "baseUrl": "/"
    },
    {
      "clientId": "tasiyoruz-customer-app",
      "name": "Taşıyoruz Müşteri Uygulaması",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "tasiyoruz://*",
        "exp://*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "tasiyoruz-driver-app",
      "name": "Taşıyoruz Nakliyeci Uygulaması",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "tasiyoruz-driver://*",
        "exp://*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "tasiyoruz-api",
      "name": "Taşıyoruz API",
      "bearerOnly": false,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "tasiyoruz-api-dev-secret",
      "redirectUris": []
    }
  ],
  "users": [
    {
      "username": "musteri@tasiyoruz.local",
      "email": "musteri@tasiyoruz.local",
      "firstName": "Test",
      "lastName": "Müşteri",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "tasiyoruz",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CUSTOMER"
      ]
    },
    {
      "username": "nakliyeci@tasiyoruz.local",
      "email": "nakliyeci@tasiyoruz.local",
      "firstName": "Test",
      "lastName": "Nakliyeci",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "tasiyoruz",
          "temporary": false
        }
      ],
      "realmRoles": [
        "DRIVER"
      ]
    },
    {
      "username": "operasyon@tasiyoruz.local",
      "email": "operasyon@tasiyoruz.local",
      "firstName": "Test",
      "lastName": "Operasyon",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "tasiyoruz",
          "temporary": false
        }
      ],
      "realmRoles": [
        "OPS_AGENT"
      ]
    },
    {
      "username": "admin@tasiyoruz.local",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@tasiyoruz.local",
      "firstName": "Sistem",
      "lastName": "Yöneticisi",
      "credentials": [
        {
          "type": "password",
          "value": "tasiyoruz",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN",
        "COMPLIANCE"
      ]
    },
    {
      "username": "service-account-tasiyoruz-api",
      "enabled": true,
      "serviceAccountClientId": "tasiyoruz-api",
      "clientRoles": {
        "realm-management": [
          "view-realm",
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    },
    {
      "username": "uyum@tasiyoruz.local",
      "email": "uyum@tasiyoruz.local",
      "firstName": "Uyum",
      "lastName": "Ekibi",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "tasiyoruz",
          "temporary": false
        }
      ],
      "realmRoles": [
        "COMPLIANCE"
      ]
    }
  ],
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": true,
  "loginTheme": "tasiyoruz",
  "accountTheme": "keycloak.v2",
  "defaultRole": {
    "name": "default-roles-tasiyoruz",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false,
    "containerId": "tasiyoruz"
  },
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "smtpServer": {
    "host": "mailhog",
    "port": "1025",
    "from": "no-reply@tasiyoruz.local",
    "fromDisplayName": "Taşıyoruz",
    "replyTo": "destek@tasiyoruz.local",
    "replyToDisplayName": "Taşıyoruz Destek",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  }
}
