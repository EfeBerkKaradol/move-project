{
  "realm": "tasiyoruz",
  "enabled": true,
  "displayName": "Taşıyoruz",
  "defaultLocale": "tr",
  "internationalizationEnabled": true,
  "supportedLocales": ["tr", "en"],
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 2592000,
  "roles": {
    "realm": [
      { "name": "CUSTOMER",       "description": "Yük sahibi" },
      { "name": "DRIVER",         "description": "Nakliyeci / sürücü" },
      { "name": "FLEET_MANAGER",  "description": "Filo yöneticisi" },
      { "name": "OPS_AGENT",      "description": "Operasyon ajanı" },
      { "name": "ADMIN",          "description": "Sistem yöneticisi" }
    ]
  },
  "clients": [
    {
      "clientId": "tasiyoruz-web",
      "name": "Taşıyoruz Web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "tasiyoruz-admin-web",
      "name": "Taşıyoruz Admin",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": ["http://localhost:3001"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "tasiyoruz-customer-app",
      "name": "Taşıyoruz Müşteri Uygulaması",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": ["tasiyoruz://*"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "tasiyoruz-driver-app",
      "name": "Taşıyoruz Nakliyeci Uygulaması",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": ["tasiyoruz-driver://*"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "tasiyoruz-api",
      "name": "Taşıyoruz API",
      "bearerOnly": true,
      "publicClient": false
    }
  ],
  "users": [
    {
      "username": "musteri@tasiyoruz.local",
      "email": "musteri@tasiyoruz.local",
      "firstName": "Test",
      "lastName": "Müşteri",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "tasiyoruz", "temporary": false }],
      "realmRoles": ["CUSTOMER"]
    },
    {
      "username": "nakliyeci@tasiyoruz.local",
      "email": "nakliyeci@tasiyoruz.local",
      "firstName": "Test",
      "lastName": "Nakliyeci",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "tasiyoruz", "temporary": false }],
      "realmRoles": ["DRIVER"]
    },
    {
      "username": "operasyon@tasiyoruz.local",
      "email": "operasyon@tasiyoruz.local",
      "firstName": "Test",
      "lastName": "Operasyon",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "tasiyoruz", "temporary": false }],
      "realmRoles": ["OPS_AGENT", "ADMIN"]
    }
  ]
}
