{
  "name": "tasiyoruz",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm -C apps/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -C apps/web lint",
    "typecheck": "pnpm -r typecheck",
    "api": "cd services/api && ./gradlew bootRun",
    "api:test": "cd services/api && ./gradlew test",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker/docker-compose.yml down -v && pnpm infra:up"
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "typescript": "5.7.3"
  }
}
