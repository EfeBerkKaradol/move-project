# ─────────────────────────────────────────────────────────────────────
# Taşıyoruz API — ortam değişkenleri
# Bu dosya git'e girmez (.gitignore). Doldurmadığın satır varsayılanıyla çalışır.
# Neyin nereden alınacağı: ../../ANAHTARLAR.md (madde numaraları aşağıda)
# ─────────────────────────────────────────────────────────────────────

# YERELDE BU DOSYA GEREKMİYOR: her ayarın çalışan bir varsayılanı var
# (Postgres, Redis, Keycloak, MinIO ve Mailhog docker-compose'dan geliyor).
# Üretim değerleri girmek için: cp .env.example .env

# ── #17 Veritabanı ve Redis (dağıtımda) ───────────────────────────────
# Yerelde docker-compose'daki Postgres ve Redis kullanılır, bu satırlar boş kalır.
# Neon: bağlantı dizesini JDBC biçimine çevir —
#   Neon'un verdiği:  postgresql://kullanici:parola@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
#   buraya yazılacak: jdbc:postgresql://ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
#   kullanıcı adı ve parola ayrı satırlara (URL'den çıkar)
DATABASE_URL=jdbc:postgresql://ep-polished-bread-ax7nwas3-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=npg_aG2RUFeAZy9i
# Upstash: parola URL'in içinde gelir. Panel redis-cli komutu verirse
# komut kısmını at ve şemayı rediss:// (çift s) yap — TLS şemadan okunuyor.
# REDIS_URL=rediss://default:<parola>@<host>:6379
REDIS_URL=rediss://default:gQAAAAAAAWyEAAIgcDEyMGU3YWI4ZmY2NGY0NWY2OWJjZjRkN2MxZDVjOWUzMw@inviting-wildcat-93316.upstash.io:6379

# ── #13 Teklif imzalama anahtarı ──────────────────────────────────────
# Yerelde boş bırak (varsayılan: local-development-secret).
# ÜRETİMDE ZORUNLU — kalırsa herkes kendi fiyatını imzalayabilir.
# Üret: openssl rand -base64 48
TASIYORUZ_QUOTE_SIGNING_SECRET=

# ── #14 CORS origin listesi ───────────────────────────────────────────
# Web uygulamasının adresleri, virgülle. Yerel varsayılan localhost:3000 ve :3001.
# Üretimde girilmezse web uygulaması API'ye hiç ulaşamaz.
TASIYORUZ_CORS_ALLOWED_ORIGINS=

# ── #19 Keycloak yönetim istemcisi ────────────────────────────────────
# Başvuru onaylanınca DRIVER rolünü verir, askıda geri alır; bildirim için
# kullanıcı e-postasını okur. Gizli anahtar boşsa bu işlevler kapalı çalışır.
KEYCLOAK_ADMIN_BASE_URL=http://localhost:8081
KEYCLOAK_REALM=tasiyoruz
KEYCLOAK_ADMIN_CLIENT_ID=tasiyoruz-api
# Yerel varsayılan: tasiyoruz-api-dev-secret. Üretimde değiştir.
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ── #20 SMTP (uygulama bildirimleri) ──────────────────────────────────
# Yerelde Mailhog: localhost:1025, gelen kutusu http://localhost:8025
# Üretimde gerçek SMTP; AUTH ve STARTTLS'i true yapmayı unutma.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=
SMTP_STARTTLS=
# Gönderen adresi ve e-postadaki bağlantıların kökü
NOTIFICATION_FROM=
NEXT_PUBLIC_SITE_URL=
# Gönderimi tamamen kapatmak için false (kayıt yine tutulur)
NOTIFICATION_ENABLED=

# ── #18 Nesne deposu (taşıyıcı belgeleri, teslim fotoğrafları) ────────
# Yerelde MinIO (docker-compose). Üretimde S3 uyumlu, Türkiye'de barındırılan kova.
# Kova HERKESE AÇIK OLMAMALI; dosyalar yalnızca API üzerinden yetkiyle iniyor.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# MinIO ve çoğu S3 uyumlu sağlayıcı yol biçimli erişim ister
STORAGE_PATH_STYLE=
# Üretimde kovayı elle oluştur, uygulama oluşturmasın
STORAGE_CREATE_BUCKET=

# ─────────────────────────────────────────────────────────────────────
# Aşağıdakiler HENÜZ HİÇBİR KOD TARAFINDAN OKUNMUYOR — entegrasyon
# yazıldığında açılacak. Şimdi doldursan da etkisi olmaz.
# ─────────────────────────────────────────────────────────────────────
# #1 Google Maps Platform — Routes/Geocoding entegrasyonu yazılınca
# GOOGLE_MAPS_API_KEY=
# #2 SMS / OTP (Netgsm, İleti Merkezi…)
# SMS_PROVIDER=
# SMS_USERNAME=
# SMS_PASSWORD=
# SMS_SENDER_HEADER=TASIYORUZ
# #3 Hata takibi
# SENTRY_DSN=
# #9 iyzico (Faz 5)
# IYZICO_BASE_URL=
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
