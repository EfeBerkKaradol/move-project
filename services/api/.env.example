# TurMove API — ortam değişkenleri şablonu
# Kopyala: cp .env.example .env   —  .env dosyası gitignore'da, asla commit etme.
# Neyin nereden alınacağı: ../../ANAHTARLAR.md

# ── Google Maps Platform (Faz 1) ────────────────────────────────
# Places (New) · Geocoding · Routes. İstemciye gömülmez, çağrılar buradan geçer.
# Boş bırakılırsa takribî mesafe sağlayıcısı devreye girer (local geliştirme).
GOOGLE_MAPS_API_KEY=

# ── SMS / OTP (Faz 1) ───────────────────────────────────────────
# Boş bırakılırsa OTP kodu uygulama loguna yazılır.
SMS_PROVIDER=
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_HEADER=

# ── Hata takibi ─────────────────────────────────────────────────
SENTRY_DSN=

# ── Nesne depolama (local: MinIO) ───────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=turmove
STORAGE_SECRET_KEY=turmove123
STORAGE_BUCKET=turmove-local

# ── Ödeme (Faz 5) ───────────────────────────────────────────────
IYZICO_BASE_URL=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
