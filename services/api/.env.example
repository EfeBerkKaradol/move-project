# ─────────────────────────────────────────────────────────────────────
# Taşıyoruz API — yerel ortam değişkenleri
# Bu dosya git'e girmez (.gitignore). Doldurmadığın satır varsayılanıyla çalışır.
# Neyin nereden alınacağı: ../../ANAHTARLAR.md (madde numaraları aşağıda)
# ─────────────────────────────────────────────────────────────────────

# ── #1 Google Maps Platform ───────────────────────────────────────────
# Places (New) · Geocoding · Routes. İstemciye gömülmez, tüm çağrılar buradan geçer.
# Boş bırakırsan takribî mesafe sağlayıcısı çalışmaya devam eder.
GOOGLE_MAPS_API_KEY=

# ── #13 Teklif imzalama anahtarı ──────────────────────────────────────
# Yerelde boş bırakabilirsin (varsayılan: local-development-secret).
# Üretimde ZORUNLU: openssl rand -base64 48
TASIYORUZ_QUOTE_SIGNING_SECRET=

# ── #14 CORS origin listesi ───────────────────────────────────────────
# Web uygulamasının adresleri, virgülle. Yerel varsayılan localhost:3000 ve :3001.
TASIYORUZ_CORS_ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────────────
# Aşağıdakiler HENÜZ OKUNMUYOR — ilgili entegrasyon gelince açılacak.
# Şimdi doldursan da etkisi olmaz; yorum olarak duruyor ki yeri belli olsun.
# ─────────────────────────────────────────────────────────────────────
# #2 SMS / OTP (Netgsm, İleti Merkezi…)
# SMS_PROVIDER=
# SMS_USERNAME=
# SMS_PASSWORD=
# SMS_SENDER_HEADER=TASIYORUZ
# #3 Hata takibi
# SENTRY_DSN=
# #9 iyzico (Faz 6)
# IYZICO_BASE_URL=
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
