# Taşıyoruz API — ortam değişkenleri şablonu
# Kopyala: cp .env.example .env   —  .env dosyası gitignore'da, asla commit etme.
# Neyin nereden alınacağı: ../../ANAHTARLAR.md

# ── Google Maps Platform (Faz 1) ────────────────────────────────
# Places (New) · Geocoding · Routes. İstemciye gömülmez, çağrılar buradan geçer.
# Boş bırakılırsa takribî mesafe sağlayıcısı devreye girer (local geliştirme).
GOOGLE_MAPS_API_KEY=

# ── SMS / OTP (Faz 1) ───────────────────────────────────────────
# Boş bırakılırsa OTP kodu uygulama loguna yazılır.
SMS_PROVIDER=
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_HEADER=

# ── Hata takibi ─────────────────────────────────────────────────
SENTRY_DSN=

# ── Nesne depolama (local: MinIO) ───────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=tasiyoruz
STORAGE_SECRET_KEY=tasiyoruz123
STORAGE_BUCKET=tasiyoruz-local

# ── Üretimde ZORUNLU ────────────────────────────────────────────
# Teklif imzalama anahtarı. Local varsayılanı güvenli değildir.
# Üretmek için: openssl rand -base64 48
TASIYORUZ_QUOTE_SIGNING_SECRET=

# API'ye erişebilecek origin'ler (virgülle ayrık)
TASIYORUZ_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Ödeme (Faz 5) ───────────────────────────────────────────────
IYZICO_BASE_URL=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
